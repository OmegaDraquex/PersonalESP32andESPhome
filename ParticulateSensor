esphome:
  name: particles
  friendly_name: Particles

# Replace this with your actual platform if you aren't using ESP32.
esp32:
  board: esp32dev

logger:

api:
  encryption:
    key: ""

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: Particles Fallback Hotspot
    password: ""

captive_portal:
# Hardware I2C Configuration (D21 & D22)
i2c:
  sda: GPIO21
  scl: GPIO22
  scan: true
  id: bus_a

sensor:
  - platform: sps30
    i2c_id: bus_a
    address: 0x69
    update_interval: 60s
    id: air_sps30

    # Particulate Matter Mass Concentration (µg/m³)
    pm_1_0:
      name: "PM 1.0"
    pm_2_5:
      name: "PM 2.5"
      id: sps30_pm2_5
    pm_4_0:
      name: "PM 4.0"
    pm_10_0:
      name: "PM 10.0"

    # Particle Number Concentration (particles/cm³)
    pmc_0_5:
      name: "PMC 0.5"
    pmc_1_0:
      name: "PMC 1.0"
    pmc_2_5:
      name: "PMC 2.5"
    pmc_4_0:
      name: "PMC 4.0"
    pmc_10_0:
      name: "PMC 10.0"

    # Typical Particle Size
    pm_size:
      name: "Typical Particle Size"

# Expose a button to Home Assistant to trigger the fan cleaning cycle
button:
  - platform: template
    name: "SPS30 Auto Clean Fan"
    icon: "mdi:fan-auto"
    on_press:
      - sps30.start_fan_autoclean: air_sps30

text_sensor:
  - platform: template
    name: "Air Quality Status"
    icon: "mdi:air-filter"
    lambda: |-
      float pm25 = id(sps30_pm2_5).state;
      if (isnan(pm25)) return {"Unknown"};
      if (pm25 <= 9.0) return {"Good (Green)"};
      if (pm25 <= 35.4) return {"Moderate (Yellow)"};
      if (pm25 <= 55.4) return {"Sensitive Groups (Orange)"};
      if (pm25 <= 125.4) return {"Unhealthy (Red)"};
      return {"Hazardous (Purple)"};
