esphome:
  name: trashcan
  friendly_name: Trashcan

esp32:
  board: esp32dev

logger:

api:
  encryption:
    key: ""

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: Trashcan Fallback Hotspot
    password: ""

captive_portal:

# 1. State Trackers
globals:
  - id: lid_is_open
    type: bool
    initial_value: 'false'
  - id: lid_hold_open
    type: bool
    initial_value: 'false'
  - id: gesture_armed
    type: bool
    initial_value: 'true'
  # Tracks how many 35ms downward micro-steps have occurred during a hold gesture
  # so we can recover back to top cleanly or finish closing without grinding stops.
  - id: ticks_down
    type: int
    initial_value: '0'

# 2. I2C Bus Configuration for the VL53L0X
i2c:
  sda: 21
  scl: 22
  scan: true
  frequency: 50kHz

# 3. Motor Output Pins
# Hardware timing constraint:
# Full open duration: 200ms (motor_ain2)
# Full close duration: 280ms (motor_ain1)
# Potential-energy ratio (Close : Open) = 1.4 : 1
switch:
  - platform: gpio
    pin: 18
    id: motor_ain1
    internal: true
    restore_mode: ALWAYS_OFF

  - platform: gpio
    pin: 19
    id: motor_ain2
    internal: true
    restore_mode: ALWAYS_OFF

# 4. Time-of-Flight Sensor
sensor:
  - platform: vl53l0x
    id: trash_distance
    name: "Trash Can Distance"
    address: 0x29
    update_interval: 200ms
    filters:
      - median:
          window_size: 3
          send_every: 1
          send_first_at: 1
    on_value:
      then:
        - binary_sensor.template.publish:
            id: hand_detected
            state: !lambda 'return (x > 0.02 && x < 0.15);'

# 5. Hand Presence Binary Sensor with Debounce
binary_sensor:
  - platform: template
    id: hand_detected
    name: "Hand Detected"
    filters:
      - delayed_off: 450ms
    on_press:
      then:
        - if:
            condition:
              lambda: 'return id(gesture_armed);'
            then:
              - if:
                  condition:
                    lambda: 'return !id(lid_hold_open);'
                  then:
                    - script.execute: auto_lid_timer
              - script.execute: hold_gesture_sequence
    on_release:
      then:
        - script.stop: hold_gesture_sequence
        - if:
            condition:
              lambda: 'return id(gesture_armed);'
            then:
              # If the user aborted mid-countdown (after 1-3 downward ticks),
              # pop the lid back to full open so it doesn't sag.
              - if:
                  condition:
                    lambda: 'return id(lid_is_open) && id(ticks_down) > 0;'
                  then:
                    - script.execute: recover_ticks_up_action
              # If in normal mode and lid is open, restart 30s timer from when hand leaves
              - if:
                  condition:
                    lambda: 'return !id(lid_hold_open) && id(lid_is_open);'
                  then:
                    - script.execute: auto_lid_timer
            else:
              # Hand was just removed after completing a lock or close gesture;
              # wait 800ms before re-arming so hand withdrawal never re-triggers.
              - delay: 800ms
              - lambda: 'id(gesture_armed) = true;'

# 6. Motor Actions and State Automation Logic
script:
  # The Timer - restarts when hand is present in normal mode
  - id: auto_lid_timer
    mode: restart
    then:
      - script.execute: open_lid_action
      # Hold open for 30 seconds
      - delay: 30s
      - if:
          condition:
            lambda: 'return !id(lid_hold_open);'
          then:
            - script.execute: close_lid_action

  # The Open Action - mode: single
  - id: open_lid_action
    mode: single
    then:
      - if:
          condition:
            - lambda: 'return !id(lid_is_open);'
          then:
            # 500ms delay added before opening so it doesn't startle you
            - delay: 500ms
            - switch.turn_off: motor_ain1
            - switch.turn_on: motor_ain2
            - delay: 200ms
            - switch.turn_off: motor_ain2
            - lambda: |-
                id(lid_is_open) = true;
                id(ticks_down) = 0;

  # The Close Action - mode: single
  # Compensates for any downward ticks already taken so it never grinds the bottom stop
  - id: close_lid_action
    mode: single
    then:
      - if:
          condition:
            - lambda: 'return id(lid_is_open);'
          then:
            - lambda: 'id(lid_is_open) = false;'
            - switch.turn_off: motor_ain2
            - switch.turn_on: motor_ain1
            - delay: !lambda |-
                int remaining_ms = 280 - (id(ticks_down) * 12);
                if (remaining_ms < 100) remaining_ms = 100;
                return remaining_ms;
            - switch.turn_off: motor_ain1
            - lambda: 'id(ticks_down) = 0;'

  # Intermediate Micro-Step Down (12ms blip - gravity assists downward movement!)
  - id: micro_step_down_action
    mode: single
    then:
      - if:
          condition:
            lambda: 'return id(lid_is_open);'
          then:
            - switch.turn_off: motor_ain2
            - switch.turn_on: motor_ain1
            - delay: 12ms
            - switch.turn_off: motor_ain1
            - lambda: 'id(ticks_down) += 1;'

  # Recover upward after downward ticks (working against gravity => 18ms open per 12ms close tick)
  # Used both as the final upward "Confirmation Nod" at 3 ticks (54ms up)
  # and if the user pulls their hand away mid-countdown.
  - id: recover_ticks_up_action
    mode: single
    then:
      - if:
          condition:
            lambda: 'return id(lid_is_open) && id(ticks_down) > 0;'
          then:
            - switch.turn_off: motor_ain1
            - switch.turn_on: motor_ain2
            - delay: !lambda |-
                int up_ms = id(ticks_down) * 18;
                if (up_ms > 80) up_ms = 80;
                return up_ms;
            - switch.turn_off: motor_ain2
            - lambda: 'id(ticks_down) = 0;'

  # Long Hold Countdown Sequence (Mode: restart, stopped on_release)
  - id: hold_gesture_sequence
    mode: restart
    then:
      - if:
          condition:
            lambda: 'return !id(lid_hold_open);'
          then:
            # --- ENTERING HOLD OPEN MODE ---
            # 0.0s - 0.7s: Lid waits 500ms and opens for 200ms.
            # Wait until 2.0s total (1.3s after lid reaches full open)
            - delay: 2000ms
            # Tick 1 (2.0s): Step down 35ms
            - script.execute: micro_step_down_action
            # Tick 2 (3.0s): Step down 35ms
            - delay: 1000ms
            - script.execute: micro_step_down_action
            # Tick 3 (4.0s): Step down 35ms (lid is now dipped ~105ms / ~37% down)
            - delay: 1000ms
            - script.execute: micro_step_down_action
            # Lock (5.0s): Pop back up to full open (75ms open) as Confirmation Nod!
            - delay: 1000ms
            - lambda: |-
                id(lid_hold_open) = true;
                id(gesture_armed) = false;
            - script.stop: auto_lid_timer
            - script.execute: recover_ticks_up_action
          else:
            # --- EXITING HOLD OPEN MODE (HOLD TO CLOSE IMMEDIATELY) ---
            # Lid is already open, so start feedback at 1.0s!
            # Tick 1 (1.0s): Step down 35ms
            - delay: 1000ms
            - script.execute: micro_step_down_action
            # Tick 2 (1.8s): Step down 35ms
            - delay: 800ms
            - script.execute: micro_step_down_action
            # Tick 3 (2.6s): Step down 35ms
            - delay: 800ms
            - script.execute: micro_step_down_action
            # Close Immediately (3.4s): Skip 30s timer and drive remaining 175ms closed!
            - delay: 800ms
            - lambda: |-
                id(lid_hold_open) = false;
                id(gesture_armed) = false;
            - script.stop: auto_lid_timer
            - script.execute: close_lid_action

# 7. Manual Overrides
button:
  - platform: template
    name: "Emergency Stop"
    icon: "mdi:stop-circle-outline"
    on_press:
      - then:
          - switch.turn_off: motor_ain1
          - switch.turn_off: motor_ain2
          - lambda: |-
              id(lid_is_open) = false;
              id(lid_hold_open) = false;
              id(gesture_armed) = true;
              id(ticks_down) = 0;
          - script.stop: auto_lid_timer
          - script.stop: hold_gesture_sequence
